model BillIncome {
    id               Int               @id @default(autoincrement()) //Them code (So Phieu Thu, sua id thanh Integer)
    code             String            @unique
    cost             Decimal           @default(0)
    status           IncomeStatus      @default(COMPLETE)
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt
    paymentMethod    IncomePaymentType @default(CASH)
    employeeId       Int
    employee         Employee          @relation(fields: [employeeId], references: [id])
    billId           Int
    bill             Bill              @relation(fields: [billId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    shortDescription String            @db.Text
    deletedAt        DateTime?
}

//Them phuong thuc thanh toan. 

model BillOutcome {
    id          Int           @id @default(autoincrement())
    code        String        @unique
    publisherId Int
    publisher   Publisher     @relation(fields: [publisherId], references: [id])
    employeeId  Int
    creator     Employee      @relation(fields: [employeeId], references: [id])
    cost        Decimal
    status      OutcomeStatus
   
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    outcomeItems BillOutcomeItem[]
    deletedAt   DateTime?
}

model BillOutcomeItem {
    id          Int           @id @default(autoincrement())

    outcomeId   Int
    outcome     BillOutcome   @relation(fields: [outcomeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    bookId      Int
    book        Book          @relation(fields: [bookId], references: [id])

    quantity    Int           @default(0)

    unitCost    Decimal

    createdAt   DateTime      @default(now())
    deleteAt DateTime? 
    @@unique([outcomeId, bookId])
    @@index([outcomeId])
    @@index([bookId])
}

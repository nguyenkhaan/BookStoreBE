model Token {
    id              Int       @id @default(autoincrement())
    token           String
    type            TokenType
    customerId      Int?
    employeeId      Int?
    createdAt       DateTime  @default(now())
    usedAt          DateTime? @default(now())
    expiresAt       DateTime
}
model UserRole {
    id              Int @id @default(autoincrement()) 
    userId          Int 
    role            Role
}
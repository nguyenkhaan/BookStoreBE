model Voucher {
    id            Int            @id @default(autoincrement())
    name          String   //Them ma khuyen mai (code) 
    eventName     String
    sale          Decimal
    status        VoucherStatus
    usedNumber    Int
    quantity      Int
    expiresAt     DateTime
    voucherUsages VoucherUsage[]
    deletedAt DateTime? 
    //Them loai giam gia: %, so tien VND 
}

model VoucherUsage {
    id           Int        @id @default(autoincrement())
    billId       String
    bill         BillIncome @relation(fields: [billIncomeId], references: [id])
    billIncomeId String
    voucherId    Int
    voucher      Voucher    @relation(fields: [voucherId], references: [id])
    usedAt       DateTime?
}

model Rule {
    id Int @id @default(autoincrement()) 
    title String 
    content String @db.Text 
    creatorId Int  
    employee      Employee     @relation(fields: [creatorId], references: [id])
    appliedAt DateTime 
    @@index([title])
    //Them loai qui dinh, trang thai (status - DANG AP DUNG...), updatedAt, shortDescription (Mo ta ngan)
}
model Department {
    id        Int        @id @default(autoincrement())
    name      String     @unique
    positions Position[]
    employees Employee[]
    deletedAt DateTime? 
}

model Position {
    id           Int        @id @default(autoincrement())
    name         String
    departmentId Int
    department   Department @relation(fields: [departmentId], references: [id])

    employees    Employee[]
    deletedAt DateTime? 
}

model Employee {
    id           Int        @id @default(autoincrement())
    code String @unique 
    email        String     @unique
    password     String
    phone        String     @unique
    name         String
    avatar       String? 
    status       EmployeeStatus
    active      Boolean  @default(false)
    departmentId Int
    department   Department @relation(fields: [departmentId], references: [id])

    positionId   Int
    position     Position   @relation(fields: [positionId], references: [id])
    billIncomes BillIncome[] 
    billOutcomes BillOutcome[] 
    riles Rule[] 
    createdAt    DateTime   @default(now())
    deletedAt DateTime? 
    //Them salary 
}
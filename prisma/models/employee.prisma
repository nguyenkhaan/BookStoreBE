model Position {
    id        Int        @id @default(autoincrement())
    name      String
    employees Employee[]
}

model Department {
    id        Int        @id @default(autoincrement())
    name      String
    employees Employee[]
}

model Employee {
    id           Int            @id @default(autoincrement())
    email        String         @unique
    password     String
    phone        String         @unique
    name         String
    status       EmployeeStatus
    positionId   Int
    position     Position       @relation(fields: [positionId], references: [id])
    departmentId Int
    department   Department     @relation(fields: [departmentId], references: [id])
    createdAt    DateTime       @default(now())
    billIncomes  BillIncome[]
    billOutcomes BillOutcome[]
}
